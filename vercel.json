{
  "framework": "vite",
  "installCommand": "git config --global url.\"https://x-access-token:${PRIVATE_REPO_TOKEN}@github.com/\".insteadOf \"https://github.com/\" && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
